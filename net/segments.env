# kt88 세그먼트(망) 정의 — 단일 진실원천.
#
# 표준 망분리 모델 그대로다. 각 망의 게이트웨이는 전부 방화벽(코어의 fw 컨테이너)이며,
# 그래서 망 간 통신은 반드시 방화벽을 지난다. 우회 경로를 막는 별도 장치가 필요 없다.
#
# 형식: <이름>|<서브넷>|<게이트웨이>|<설명>

KT88_PARENT_IF="enp1s0"     # macvlan 이 올라탈 물리 인터페이스 (전 호스트 동일 기종)

KT88_SEGMENTS="
ext|10.30.10.0/24|10.30.10.1|외부망 — 공격자
dmz|10.30.20.0/24|10.30.20.1|DMZ — 공개 웹서버
int|10.30.30.0/24|10.30.30.1|내부망 — 업무 엔드포인트
res|10.30.40.0/24|10.30.40.1|연구망 — 분석/샌드박스
"

# 호스트 배치 (호스트는 '어느 망의 장비를 올리는가'만 정하면 된다)
#   192.168.0.202  core       방화벽/IPS/WAF/SIEM — 모든 망의 게이트웨이
#   192.168.0.203  worker     내부망(int) 엔드포인트 — 리눅스 + 윈도우
#   192.168.0.231  research   연구망(res) 엔드포인트
